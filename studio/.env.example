# Copy to .env.local for local dev (never commit). The Mac mini server uses ../.env instead.
# Instagram publishing ("이대로 발행하기"). brands/<brand>.json names the variables per brand.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Public address Instagram can fetch publish images from (local dev usually has none).
PUBLIC_BASE_URL=
# Optional
META_GRAPH_VERSION=v24.0

# AI caption drafts and manuscript AI
ANTHROPIC_API_KEY=
